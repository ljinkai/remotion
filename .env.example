# Azure Speech — 门户 → 语音资源 → 密钥和终结点
AZURE_SPEECH_KEY=your-speech-key-here
AZURE_SPEECH_REGION=eastasia
AZURE_SPEECH_VOICE=zh-CN-YunxiNeural
# English weekly videos (VidFlow locale=en): en-US-JennyNeural

# 通义千问 — 生成口播逐字稿（DashScope）
# 也可只填 QWEN_API_KEY（与 vidflow 共用）
SCRIPT_LLM_API_KEY=
# SCRIPT_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 国内账号可用：https://dashscope.aliyuncs.com/compatible-mode/v1
SCRIPT_LLM_MODEL=qwen-plus
# QWEN_API_KEY=

# Render service API（VidFlow 等调用方）
# 代码默认：vidflow-remotion-shared-key-2026；可用环境变量覆盖
# RENDER_API_KEY=
# 可选：webhook HMAC 单独密钥（默认复用 RENDER_API_KEY / 内置默认）
# RENDER_WEBHOOK_SECRET=

# 七牛 — 成片上传（服务模式必填）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_CDN_DOMAIN=
# 对象 key 前缀（目录），默认 weekly-video → weekly-video/{client_ref}/{job}.mp4
QINIU_KEY_PREFIX=weekly-video

# Workbench / 服务端口（可选）
PORT=5177
# HOST=0.0.0.0
